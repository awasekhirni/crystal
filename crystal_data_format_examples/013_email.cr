# --- 4. A minimal SMTP client session (stdlib, for the demo) ----------------
# We don't connect to a real server (no SMTP server in the sandbox); instead we
# simulate the protocol exchange to show what an SMTP conversation looks like.
module SmtpProtocol
  # Returns the lines a client would send to deliver `message` to `recipients`.
  def self.client_script(from : String, recipients : Array(String), message : String) : Array(String)
    lines = [] of String
    lines << "HELO localhost"
    lines << "MAIL FROM:<#{from}>"
    recipients.each { |r| lines << "RCPT TO:<#{r}>" }
    lines << "DATA"
    # The message body follows, terminated by a line containing only ".".
    message.each_line { |l| lines << l.chomp }
    lines << "."
    lines << "QUIT"
    lines
  end
end

# ---------------------------------------------------------------------------
# Demonstrative main
# ---------------------------------------------------------------------------
puts "=== Email (RFC 5322 + SMTP) ==="

msg = EmailBuilder.build(
  from: "ada@example.com",
  to: ["bob@example.com", "carol@example.com"],
  subject: "Hello from Crystal",
  body: "Hi!\n\nThis is a test email generated by crystal.\n\n--Ada"
)
puts "--- raw message ---"
puts msg

puts "\n--- parsed headers ---"
headers, body = EmailParser.parse(msg)
headers.each { |h| puts "  #{h.name}: #{h.value}" }
puts "\n--- body ---"
puts body

puts "\n--- find specific header ---"
puts "  Subject: #{EmailParser.find_header(headers, "Subject")}"
puts "  To: #{EmailParser.find_header(headers, "To")}"

puts "\n--- non-ASCII subject (RFC 2047 encoded) ---"
unicode_msg = EmailBuilder.build("x@y.com", ["a@b.com"], "Привет", "body")
puts "  #{EmailParser.find_header(EmailParser.parse(unicode_msg)[0], "Subject")}"

puts "\n--- SMTP client script (the lines we'd send) ---"
SmtpProtocol.client_script("ada@example.com", ["bob@example.com"], msg).each_with_index do |line, i|
  puts "  C: #{line}"
end

# ---------------------------------------------------------------------------
# EXERCISES
# ---------------------------------------------------------------------------

# --- Exercise 1: build and parse a message, verify the subject round-trips -
def exercise_1
  msg = EmailBuilder.build("a@b.com", ["c@d.com"], "Test Subject", "body text")
  headers, _ = EmailParser.parse(msg)
  subject = EmailParser.find_header(headers, "Subject")
  puts "Exercise 1 -> subject = #{subject} (expect Test Subject)"
end

# --- Exercise 2: parse a multi-recipient To header --------------------------
def exercise_2
  msg = EmailBuilder.build("a@b.com", ["one@x.com", "two@x.com", "three@x.com"], "S", "b")
  headers, _ = EmailParser.parse(msg)
  to = EmailParser.find_header(headers, "To").not_nil!
  count = to.split(",").size
  puts "Exercise 2 -> To header has #{count} recipients (expect 3)"
end

# --- Exercise 3: generate the SMTP script and verify DATA..QUIT structure ----
def exercise_3
  msg = EmailBuilder.build("a@b.com", ["c@d.com"], "S", "hello\nworld")
  script = SmtpProtocol.client_script("a@b.com", ["c@d.com"], msg)
  has_data = script.includes?("DATA")
  has_quit = script.last == "QUIT"
  has_dot = script[-2] == "."
  puts "Exercise 3 -> has DATA? #{has_data}; ends with '.' then QUIT? #{has_dot && has_quit}"
end

puts "\n=== Running exercises ==="
exercise_1
exercise_2
exercise_3
