# 013_email.cr
# ---------------------------------------------------------------------------
# Format: Email (RFC 5322 message format + SMTP sending)
# ---------------------------------------------------------------------------
# ELI5:
#   An email is a text document with a specific structure: headers (From, To,
#   Subject, Date, Content-Type), a blank line, then the body. To SEND one, you
#   connect to an SMTP server (port 25/587/465) and speak the SMTP protocol
#   (HELO, MAIL FROM, RCPT TO, DATA, QUIT). The table says "SMTP shard" - there
#   are Crystal shards (e.g. emaillabs/crystal-email) that wrap this. Here we
#   build the message by hand (stdlib) AND show the SMTP shard idiom.
#
# Best approach (per the table): an SMTP shard for sending.
#   (deps.yml: email github: arcage/crystal-email)
#
# Run:  crystal 013_email.cr       (Crystal 1.x, stdlib; SMTP exercise needs a server)
# ---------------------------------------------------------------------------

require "json"
require "base64"

# --- 1. Build an RFC 5322 email message by hand (stdlib) -------------------
module EmailBuilder
  # Construct an email message string.
  def self.build(from : String, to : Array(String), subject : String, body : String, mime = "text/plain") : String
    headers = [] of String
    headers << "From: #{from}"
    headers << "To: #{to.join(", ")}"
    headers << "Subject: #{encode_if_needed(subject)}"
    headers << "Date: #{Time.utc(2026, 1, 1, 12, 0, 0).to_rfc2822}"
    headers << "MIME-Version: 1.0"
    headers << "Content-Type: #{mime}; charset=UTF-8"
    headers.join("\r\n") + "\r\n\r\n" + body + "\r\n"
  end

  # RFC 2047 style: if the subject has non-ASCII, encode as =?UTF-8?B?...?=
  def self.encode_if_needed(s : String) : String
    if s.each_char.all? { |c| c.ord < 128 }
      s
    else
      "=?UTF-8?B?#{Base64.strict_encode(s)}?="
    end
  end
end

# --- 2. Parse a message back (split headers from body) ----------------------
module EmailParser
  record Header, name : String, value : String

  def self.parse(message : String) : {Array(Header), String}
    # Headers and body are separated by the first blank line (\r\n\r\n).
    parts = message.split("\r\n\r\n", 2)
    header_block = parts[0]
    body = parts[1]? || ""
    headers = header_block.split("\r\n").map do |line|
      if idx = line.index(':')
        Header.new(line[0...idx].strip, line[(idx + 1)..].strip)
      else
        Header.new(line, "")
      end
    end
    {headers, body}
  end

  def self.find_header(headers : Array(Header), name : String) : String?
    headers.find { |h| h.name.downcase == name.downcase }.try(&.value)
  end
end

# --- 3. The "SMTP shard" idiom (shown as comments; needs the shard) ---------
#
# require "email"
